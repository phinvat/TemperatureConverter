<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TemperatureConverter.ViewModels"
             xmlns:models="clr-namespace:TemperatureConverter.Models"
             x:Class="TemperatureConverter.MainPage"
             Title="Home">

    <!-- Set ViewModel as BindingContext -->
    <ContentPage.BindingContext>
        <vm:CustomerViewModel />
    </ContentPage.BindingContext>

    <Grid Margin="10" RowDefinitions="*, Auto">
        
        <!-- Customer List View -->
        <CollectionView x:Name="CustomersView" ItemsSource="{Binding Customers}" Grid.Row="0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Customer">
                    <VerticalStackLayout Padding="10" Spacing="5">
                        <Label Text="{Binding Id}" FontSize="14" />
                        <Entry Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />
                        <Entry Text="{Binding Address}" FontSize="14" />
                        <Entry Text="{Binding Country}" FontSize="14" />
                        <BoxView HeightRequest="1" Color="LightGray" Margin="0,5" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom Action Buttons -->
        <StackLayout Orientation="Horizontal" Spacing="5" Grid.Row="1" Margin="0,10,0,0">
            <Button Text="Add"
                    Command="{Binding AddNewCommand}"
                    WidthRequest="90"
                    BackgroundColor="#512BD4"
                    TextColor="White" />
            
            <Button Text="Remove"
                    Command="{Binding DeleteCommand}"
                    WidthRequest="90"
                    BackgroundColor="#512BD4"
                    TextColor="White" />
            
            <Button Text="Save all"
                    Command="{Binding SaveAllCommand}"
                    WidthRequest="90"
                    BackgroundColor="#512BD4"
                    TextColor="White" />
        </StackLayout>

    </Grid>
</ContentPage>